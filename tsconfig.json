{
  "compilerOptions": {
    "target": "ES2017",
    "ignoreDeprecations": "6.0",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@supabase/supabase-js": [
        "./src/shims/supabase-js"
      ],
      "@supabase/ssr": [
        "./src/shims/supabase-ssr"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    "**/*.mts",
    "build-next/types/**/*.ts",
    "build-next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    ".next",
    "build-next"
  ]
}
